# ── FinPulse Backend Environment Variables ─────────────────────────────────
# Copy this file: cp .env.example .env
# Then fill in your real values.
# NEVER commit .env to GitHub — it contains secrets.

# MongoDB Atlas connection string
# Get from: https://cloud.mongodb.com → Cluster → Connect → Drivers
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/finpulse

# Alpha Vantage API key (free: 25 calls/day, $50/mo for premium)
# Get from: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=YOUR_KEY_HERE

# Anthropic API key (for AI portfolio insights)
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=YOUR_KEY_HERE

# Server port
PORT=5000

# Set to "true" to use mock data even if API keys are present (useful for dev)
USE_MOCK_DATA=false
